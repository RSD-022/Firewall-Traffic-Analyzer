    "train_path = ROOT / \"data\" / \"processed\" / \"train.csv\"\n",
    "train_df = pd.read_csv(train_path)\n",
    "\n",
    "X_train = train_df.drop(columns=[\"Action\"])\n",
    "y_train = train_df[\"Action\"]\n",
    "\n",
    "print(\"Training features shape:\", X_train.shape)\n",
    "print(\"Training labels shape:  \", y_train.shape)\n",
    "assert X_train.shape == (45736, 11), f\"Expected (45736, 11), got {X_train.shape}\"\n",
    "\n",
    "class_counts = y_train.value_counts()\n",
    "class_shares = (y_train.value_counts(normalize=True) * 100).round(4)\n",
    "dist_df = pd.DataFrame({\"Count\": class_counts, \"Percentage (%)\": class_shares})\n",
    "print(\"\\nTraining Class Distribution:\")\n",
